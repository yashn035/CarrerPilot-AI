<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{personalInfo.fullName}} - Resume</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: {{#if (eq templateId "minimal")}}'Courier New', Courier, monospace{{else if (eq templateId "creative")}}'Poppins', 'Helvetica Neue', sans-serif{{else if (eq templateId "professional")}}'Times New Roman', Times, serif{{else}}'Inter', 'Segoe UI', Arial, sans-serif{{/if}};
    }

    body {
      background: #ffffff;
      color: {{#if (eq templateId "minimal")}}#111111{{else if (eq templateId "creative")}}#1e1b4b{{else}}#1e293b{{/if}};
      padding: 30px 40px;
      font-size: 13px;
      line-height: 1.5;
    }

    /* HEADER STYLES */
    .header {
      margin-bottom: 20px;
      {{#if (eq templateId "creative")}}
      background: linear-gradient(135deg, #4f46e5, #7c3aed);
      color: #ffffff;
      padding: 24px;
      border-radius: 8px;
      {{else if (eq templateId "modern")}}
      border-bottom: 3px solid #2563eb;
      padding-bottom: 12px;
      {{else if (eq templateId "professional")}}
      border-bottom: 1px solid #475569;
      padding-bottom: 12px;
      text-align: center;
      {{else if (eq templateId "minimal")}}
      border-bottom: 1px dashed #000;
      padding-bottom: 10px;
      {{/if}}
    }

    .header h1 {
      font-size: 26px;
      font-weight: 700;
      letter-spacing: -0.5px;
      margin-bottom: 4px;
      {{#if (eq templateId "creative")}}color: #ffffff;{{/if}}
    }

    .header .subtitle {
      font-size: 14px;
      font-weight: 600;
      color: {{#if (eq templateId "creative")}}#e0e7ff{{else}}#2563eb{{/if}};
      margin-bottom: 8px;
    }

    .contact-info {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      font-size: 11px;
      color: {{#if (eq templateId "creative")}}#cbd5e1{{else}}#64748b{{/if}};
      {{#if (eq templateId "professional")}}justify-content: center;{{/if}}
    }

    .contact-info span {
      display: inline-flex;
      align-items: center;
    }

    /* SECTIONS */
    .section {
      margin-bottom: 18px;
    }

    .section-title {
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 8px;
      {{#if (eq templateId "modern")}}
      color: #2563eb;
      border-bottom: 1px solid #e2e8f0;
      padding-bottom: 3px;
      {{else if (eq templateId "creative")}}
      color: #7c3aed;
      border-bottom: 2px solid #ddd6fe;
      padding-bottom: 3px;
      {{else if (eq templateId "professional")}}
      color: #0f172a;
      border-bottom: 1px solid #0f172a;
      padding-bottom: 2px;
      {{else if (eq templateId "minimal")}}
      color: #000000;
      text-decoration: underline;
      {{/if}}
    }

    /* SUMMARY */
    .summary-text {
      color: #334155;
      font-size: 12px;
    }

    /* EXPERIENCE & PROJECTS & EDUCATION */
    .item {
      margin-bottom: 10px;
    }

    .item-header {
      display: flex;
      justify-content: space-between;
      font-weight: 700;
      font-size: 13px;
      color: #0f172a;
    }

    .item-subheader {
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      font-weight: 500;
      color: #64748b;
      margin-bottom: 4px;
    }

    ul.bullets {
      margin-left: 18px;
      font-size: 12px;
      color: #334155;
    }

    ul.bullets li {
      margin-bottom: 3px;
    }

    /* SKILLS BADGES */
    .skills-group {
      margin-bottom: 6px;
      font-size: 12px;
    }

    .skills-group strong {
      color: #0f172a;
    }

    .badge-container {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 4px;
    }

    .badge {
      font-size: 11px;
      padding: 2px 8px;
      border-radius: 4px;
      {{#if (eq templateId "creative")}}
      background: #f3e8ff;
      color: #6b21a8;
      {{else if (eq templateId "modern")}}
      background: #eff6ff;
      color: #1e40af;
      {{else}}
      background: #f1f5f9;
      color: #334155;
      border: 1px solid #cbd5e1;
      {{/if}}
    }
  </style>
</head>
<body>

  <!-- HEADER SECTION -->
  <div class="header">
    <h1>{{personalInfo.fullName}}</h1>
    {{#if targetRole}}<div class="subtitle">{{targetRole}}</div>{{/if}}
    <div class="contact-info">
      {{#if personalInfo.email}}<span>✉ {{personalInfo.email}}</span>{{/if}}
      {{#if personalInfo.phone}}<span>📞 {{personalInfo.phone}}</span>{{/if}}
      {{#if personalInfo.location}}<span>📍 {{personalInfo.location}}</span>{{/if}}
      {{#if personalInfo.linkedin}}<span>🔗 {{personalInfo.linkedin}}</span>{{/if}}
      {{#if personalInfo.github}}<span>💻 {{personalInfo.github}}</span>{{/if}}
      {{#if personalInfo.portfolio}}<span>🌐 {{personalInfo.portfolio}}</span>{{/if}}
    </div>
  </div>

  <!-- SUMMARY SECTION -->
  {{#if summary}}
  <div class="section">
    <div class="section-title">Professional Summary</div>
    <p class="summary-text">{{summary}}</p>
  </div>
  {{/if}}

  <!-- EXPERIENCE SECTION -->
  {{#if experience.length}}
  <div class="section">
    <div class="section-title">Work Experience</div>
    {{#each experience}}
    <div class="item">
      <div class="item-header">
        <span>{{position}}</span>
        <span>{{startDate}} - {{#if current}}Present{{else}}{{endDate}}{{/if}}</span>
      </div>
      <div class="item-subheader">
        <span>{{company}}</span>
        <span>{{location}}</span>
      </div>
      <ul class="bullets">
        {{#each bullets}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
    </div>
    {{/each}}
  </div>
  {{/if}}

  <!-- PROJECTS SECTION -->
  {{#if projects.length}}
  <div class="section">
    <div class="section-title">Key Projects</div>
    {{#each projects}}
    <div class="item">
      <div class="item-header">
        <span>{{title}} {{#if link}}<small>({{link}})</small>{{/if}}</span>
      </div>
      {{#if subtitle}}<div class="item-subheader">{{subtitle}}</div>{{/if}}
      <ul class="bullets">
        {{#each bullets}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
    </div>
    {{/each}}
  </div>
  {{/if}}

  <!-- EDUCATION SECTION -->
  {{#if education.length}}
  <div class="section">
    <div class="section-title">Education</div>
    {{#each education}}
    <div class="item">
      <div class="item-header">
        <span>{{degree}} {{#if fieldOfStudy}}in {{fieldOfStudy}}{{/if}}</span>
        <span>{{startDate}} - {{endDate}}</span>
      </div>
      <div class="item-subheader">
        <span>{{institution}}</span>
        {{#if gpa}}<span>GPA: {{gpa}}</span>{{/if}}
      </div>
    </div>
    {{/each}}
  </div>
  {{/if}}

  <!-- SKILLS SECTION -->
  {{#if (or skills.technical.length skills.frameworks.length skills.tools.length skills.soft.length)}}
  <div class="section">
    <div class="section-title">Skills & Competencies</div>
    {{#if skills.technical.length}}
    <div class="skills-group">
      <strong>Technical Skills:</strong>
      <div class="badge-container">
        {{#each skills.technical}}<span class="badge">{{this}}</span>{{/each}}
      </div>
    </div>
    {{/if}}
    {{#if skills.frameworks.length}}
    <div class="skills-group">
      <strong>Frameworks & Libraries:</strong>
      <div class="badge-container">
        {{#each skills.frameworks}}<span class="badge">{{this}}</span>{{/each}}
      </div>
    </div>
    {{/if}}
    {{#if skills.tools.length}}
    <div class="skills-group">
      <strong>Tools & Technologies:</strong>
      <div class="badge-container">
        {{#each skills.tools}}<span class="badge">{{this}}</span>{{/each}}
      </div>
    </div>
    {{/if}}
  </div>
  {{/if}}

  <!-- CERTIFICATIONS SECTION -->
  {{#if certifications.length}}
  <div class="section">
    <div class="section-title">Certifications</div>
    {{#each certifications}}
    <div class="item">
      <div class="item-header">
        <span>{{name}} - {{issuer}}</span>
        <span>{{date}}</span>
      </div>
    </div>
    {{/each}}
  </div>
  {{/if}}

  <!-- ACHIEVEMENTS SECTION -->
  {{#if achievements.length}}
  <div class="section">
    <div class="section-title">Achievements</div>
    {{#each achievements}}
    <div class="item">
      <div class="item-header">
        <span>{{title}}</span>
        <span>{{date}}</span>
      </div>
      <p class="summary-text">{{description}}</p>
    </div>
    {{/each}}
  </div>
  {{/if}}

</body>
</html>
