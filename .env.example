# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=careerpilot-super-secret-key-123456
FRONTEND_URL=http://localhost:3000

# Database Connections
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/careerpilot?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# AI Provider API Keys
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
CLAUDE_API_KEY=your_claude_api_key
CLAUDE_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Semantic Cache Configuration
SEMANTIC_CACHE_ENABLED=true
SIMILARITY_THRESHOLD=0.92
CACHE_TTL=604800

# Code Execution Sandbox
USE_LOCAL_SANDBOX=true
SANDBOX_TIMEOUT=5000
SANDBOX_MEMORY=128
PISTON_FALLBACK_ENABLED=true

# Puppeteer PDF Export
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
